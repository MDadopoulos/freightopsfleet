# --- Gemini / Vertex ---------------------------------------------------------
# Option A: Gemini Developer API (simplest for local work)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# Option B: Vertex AI (use for deployment + durable sessions)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# --- Fleet -------------------------------------------------------------------
# Start the hero on a stronger model; drop to flash only if the score holds.
FREIGHT_MODEL=gemini-3.1-pro
FREIGHT_WORKSPACE_ROOT=./workspace
FREIGHT_LEDGER_PATH=./audit/ledger.jsonl
